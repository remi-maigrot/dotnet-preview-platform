          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(max without (instance, pod, container, endpoint, service, namespace) (preview_environments{phase=\"Provisioning\", job=\"preview-operator\"}))",
          "legendFormat": "Provisioning",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
