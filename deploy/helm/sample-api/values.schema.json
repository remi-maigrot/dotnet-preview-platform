{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "sample-api chart values",
  "type": "object",
  "required": ["image", "secrets", "migrations", "resources"],
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "type": "object", "required": ["cpu", "memory"] },
        "limits": { "type": "object", "required": ["memory"] }
      }
    }
  },
  "properties": {
    "image": {
      "allOf": [
        { "$ref": "#/definitions/image" },
        {
          "properties": {
            "tag": {
              "type": "string",
              "not": { "enum": ["latest"] },
              "description": "Git commit SHA. 'latest' is rejected: deployments must be reproducible."
            }
          }
        }
      ]
    },
    "imagePullSecrets": { "type": "array" },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "config": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] },
      "propertyNames": { "pattern": "^[A-Za-z0-9_]+$" },
      "not": {
        "anyOf": [
          { "required": ["Database__ConnectionString"] },
          { "required": ["Authentication__Jwt__SigningKey"] }
        ]
      },
      "description": "Non-secret settings only. Connection strings and keys belong in secrets.existingSecret."
    },
    "secrets": {
      "type": "object",
      "required": ["existingSecret"],
      "properties": { "existingSecret": { "type": "string" } }
    },
    "rollout": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "steps": { "type": "array", "minItems": 1 },
        "analysis": {
          "type": "object",
          "properties": {
            "prometheusAddress": { "type": "string", "pattern": "^https?://.+" },
            "failureLimit": { "type": "integer", "minimum": 0 },
            "maxErrorRatio": { "type": "number", "minimum": 0, "maximum": 1 },
            "maxP95Seconds": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "grafanaAnnotation": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "url": { "type": "string", "pattern": "^https?://.+" },
        "tokenSecret": { "type": "string" }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": { "properties": { "tokenSecret": { "minLength": 1 } } }
    },
    "backup": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "schedule": { "type": "string", "minLength": 9 },
        "keepDays": { "type": "integer", "minimum": 1, "maximum": 365 },
        "existingSecret": { "type": "string" },
        "recipients": { "type": "array", "items": { "type": "string", "pattern": "^age1[0-9a-z]{58}$" } },
        "restoreTest": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "schedule": { "type": "string", "minLength": 9 },
            "maxAgeHours": { "type": "integer", "minimum": 1 },
            "identitySecret": { "type": "string" }
          }
        }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": { "required": ["existingSecret", "recipients"], "properties": { "recipients": { "minItems": 1 } } }
    },
    "migrations": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "existingSecret": { "type": "string" },
        "backoffLimit": { "type": "integer", "minimum": 0, "maximum": 5 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 30 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "opentelemetry": {
      "type": "object",
      "properties": {
        "endpoint": { "type": "string", "pattern": "^(https?://.+)?$" },
        "resourceAttributes": { "type": "string" },
        "metricExportIntervalMs": { "type": "integer", "minimum": 1000 }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "tls": { "type": "object" }
      }
    },
    "resources": { "$ref": "#/definitions/resources" },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 10, "maximum": 100 }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "preStopSleepSeconds": { "type": "integer", "minimum": 0, "maximum": 30 },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 10, "maximum": 120 },
    "podSecurityContext": {
      "type": "object",
      "required": ["runAsNonRoot"],
      "properties": { "runAsNonRoot": { "const": true } }
    },
    "securityContext": {
      "type": "object",
      "required": ["allowPrivilegeEscalation", "readOnlyRootFilesystem", "capabilities"],
      "properties": {
        "allowPrivilegeEscalation": { "const": false },
        "readOnlyRootFilesystem": { "const": true },
        "privileged": { "const": false }
      }
    },
    "networkPolicy": { "type": "object" },
    "release": {
      "type": "object",
      "properties": {
        "sha": { "type": "string" },
        "author": { "type": "string" }
      }
    }
  }
}
