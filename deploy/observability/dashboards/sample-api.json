{
  "uid": "sample-api",
  "title": "Sample API: RED and SLO",
  "description": "Rate, errors and duration of the absence API per environment, its SLO (99.5 % of requests without a 5xx and under 300 ms) and the logs and traces behind them.",
  "tags": [
    "sample-api",
    "slo",
    "preview-platform"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "iconColor": "purple",
        "name": "Releases",
        "target": {
          "type": "tags",
          "tags": [
            "release",
            "$namespace"
          ],
          "matchAny": false,
          "limit": 100
        }
      }
    ]
  },
  "links": [
    {
      "title": "Preview environments",
      "type": "dashboards",
      "tags": [
        "previews"
      ],
      "asDropdown": false,
      "includeVars": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count{job=\"sample-api\"}, k8s_namespace_name)",
          "refId": "ns"
        },
        "definition": "label_values(http_server_request_duration_seconds_count{job=\"sample-api\"}, k8s_namespace_name)",
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "local",
          "value": "local"
        },
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "SLO: 99.5 % of requests without a 5xx and under 300 ms",
      "id": 1,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "SLI over the selected range",
      "description": "Share of requests answered without a 5xx and in 300 ms or less, over the time range of the dashboard.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(http_server_request_duration_seconds_bucket{job=\"sample-api\", k8s_namespace_name=\"$namespace\", http_route!~\"/health/.*|/metrics\", le=\"0.3\", http_response_status_code!~\"5..\"}[$__range])) / sum(increase(http_server_request_duration_seconds_count{job=\"sample-api\", k8s_namespace_name=\"$namespace\", http_route!~\"/health/.*|/metrics\"}[$__range]))",
          "legendFormat": "SLI",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "id": 2,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Error budget left (30 days)",
      "description": "1 means the 0.5 % budget is untouched, 0 that it is spent, below 0 that the SLO is broken. Locally Prometheus keeps 7 days: the 30-day figure covers what is retained.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (1 - sum(increase(http_server_request_duration_seconds_bucket{job=\"sample-api\", k8s_namespace_name=\"$namespace\", http_route!~\"/health/.*|/metrics\", le=\"0.3\", http_response_status_code!~\"5..\"}[30d])) / sum(increase(http_server_request_duration_seconds_count{job=\"sample-api\", k8s_namespace_name=\"$namespace\", http_route!~\"/health/.*|/metrics\"}[30d]))) / 0.005",
          "legendFormat": "Budget left",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.25
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "id": 3,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Burn rate",
      "description": "How fast the error budget burns: 1 spends it exactly in 30 days. The fast-burn alert fires above 14.4 (1 h and 5 min windows), the medium one above 6 (6 h and 30 min).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sample_api:slo_errors:ratio_rate1h{k8s_namespace_name=\"$namespace\"} / 0.005",
          "legendFormat": "1 h",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sample_api:slo_errors:ratio_rate6h{k8s_namespace_name=\"$namespace\"} / 0.005",
          "legendFormat": "6 h",
          "refId": "B",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sample_api:slo_errors:ratio_rate5m{k8s_namespace_name=\"$namespace\"} / 0.005",
          "legendFormat": "5 min",
          "refId": "C",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "row",
      "title": "Requests",
      "id": 5,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Requests per second by route",
      "description": "User traffic only: health probes and scrapes are left out.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (http_request_method, http_route) (rate(http_server_request_duration_seconds_count{job=\"sample-api\", k8s_namespace_name=\"$namespace\", http_route!~\"/health/.*|/metrics\"}[$__rate_interval]))",
          "legendFormat": "{{http_request_method}} {{http_route}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
