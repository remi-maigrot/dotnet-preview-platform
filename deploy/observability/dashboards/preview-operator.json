        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"preview-system\", container=\"operator\"})",
          "legendFormat": "{{pod}}",
