# Copy to .env (git-ignored) to run the API container outside Kubernetes:
#   docker run --env-file .env -p 8080:8080 sample-api:local
# Every key maps to a configuration entry: "__" separates sections.

ASPNETCORE_ENVIRONMENT=Development
Database__ConnectionString=Host=host.docker.internal;Database=absences;Username=absences;Password=change-me;Gss Encryption Mode=Disable
# At least 32 characters. Generate one with: openssl rand -base64 48
Authentication__Jwt__SigningKey=
# Optional: send traces, metrics and logs to an OpenTelemetry collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
Features__AutoApproveSickLeave=true
