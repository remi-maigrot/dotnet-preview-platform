        "justifyMode": "auto"
      },
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Pending",
      "description": "PreviewEnvironments in phase Pending.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(max without (instance, pod, container, endpoint, service, namespace) (preview_environments{phase=\"Pending\", job=\"preview-operator\"}))",
          "legendFormat": "Pending",
          "refId": "A",
