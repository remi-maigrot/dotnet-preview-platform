          },
          "expr": "(sum(rate(http_server_request_duration_seconds_count{job=\"sample-api\", k8s_namespace_name=\"$namespace\", http_route!~\"/health/.*|/metrics\", http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{job=\"sample-api\", k8s_namespace_name=\"$namespace\", http_route!~\"/health/.*|/metrics\"}[$__rate_interval]))",
