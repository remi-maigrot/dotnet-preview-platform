{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Host": {
    "ShutdownTimeout": "00:00:25"
  },
  "Database": {
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 3
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "preview-platform",
      "Audience": "sample-api"
    }
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "Window": "00:00:10"
  },
  "Idempotency": {
    "Retention": "1.00:00:00",
    "PurgeInterval": "01:00:00"
  },
  "Features": {
    "AutoApproveSickLeave": false,
    "ExternalHolidayCalendar": false
  },
  "HolidayCalendar": {
    "CountryCode": "FR",
    "AttemptTimeout": "00:00:02",
    "TotalTimeout": "00:00:08",
    "MaxRetryAttempts": 3
  },
  "Telemetry": {
    "PrometheusEndpoint": true
  }
}
